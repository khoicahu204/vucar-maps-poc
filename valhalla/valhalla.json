{
  "mjolnir": {
    "tile_dir": "/data/valhalla",
    "admin": "/data/valhalla/admin.sqlite",
    "timezone": "/data/valhalla/tz.sqlite",
    "languages": "/data/valhalla/languages.json",
    "build_elevation": false,
    "build_admins": true,
    "build_time_zones": true,
    "use_connectivity": true,
    "data_processing": {
      "use_admin_db": true,
      "use_reverse_distance": true,
      "use_width": true,
      "use_rest_area": true,
      "use_urban_tag": true,
      "use_custom_curbs": true,
      "default_curbs": true
    }
  },
  "loki": {
    "actions": ["locate", "route", "sources_to_targets", "optimized_route", "isochrone", "trace_route", "trace_attributes"],
    "logging": {
      "type": "std_out",
      "level": "info"
    },
    "service": {
      "proxy": "http://valhalla:8002",
      "max_concurrent_requests": 8
    },
    "use_grid": true,
    "use_minimum_connected_graph": true
  },
  "thor": {
    "logging": {
      "type": "std_out",
      "level": "info"
    },
    "max_matrix_distance": 100000,
    "max_matrix_locations": 100
  },
  "odin": {
    "logging": {
      "type": "std_out",
      "level": "info"
    }
  },
  "service_limits": {
    "auto": {"max_distance": 1000000},
    "bicycle": {"max_distance": 500000},
    "motor_scooter": {"max_distance": 1000000, "max_matrix_distance": 100000, "max_matrix_locations": 100, "max_route_distance": 1000000},
    "pedestrian": {"max_distance": 250000}
  }
}
